# Grok X Search Environment Configuration
# Copy this file to .env and fill in your values
# cp env.example .env

# ===========================================
# XAI API Configuration (Required for Grok features)
# ===========================================
# Get your API key from https://x.ai
XAI_API_KEY=your-xai-api-key-here

# Grok model to use (optional, defaults to grok-3-latest)
GROK_MODEL=grok-3-latest

# ===========================================
# Application Settings (Optional)
# ===========================================
# Enable debug mode for development
DEBUG=false

# ===========================================
# Database (Optional - defaults to SQLite)
# ===========================================
# DATABASE_URL=sqlite:///./data/xsearch.db

# ===========================================
# Scraping Settings (Optional)
# ===========================================
# SCRAPE_RATE_LIMIT=5
# SCRAPE_DELAY=2.0
# MAX_POSTS_PER_ACCOUNT=100

